# QueueFlow Customer Web Environment Variables
# Note: Variables starting with VITE_ are exposed to the browser.
# DO NOT put server secrets, JWT secrets, or DB credentials here!

# The API ORIGIN — do NOT append /api.
# src/services/api.js appends the "/api" prefix itself, so setting this to
# ".../api" ships a bundle that calls /api/api/... and 404s every request
# (including login). Resulting login call: <VITE_API_URL>/api/auth/login
VITE_API_URL=http://localhost:5000

# Socket.IO connects to the bare origin; it manages its own /socket.io path.
VITE_SOCKET_URL=http://localhost:5000
