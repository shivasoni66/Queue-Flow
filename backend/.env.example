# ─── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/queueflow?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────
# Use a strong random secret in production (minimum 64 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── IoT ──────────────────────────────────────────
# Shared secret for IoT device authentication
IOT_SECRET=your_iot_device_secret_key

# ─── QR Signing ───────────────────────────────────
# Dedicated secret for QR payload HMAC-SHA256 signing.
# MUST be different from JWT_SECRET. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this secret invalidates ALL existing QR codes (customers must request new ones).
QR_SIGNING_SECRET=

# ─── Dev Simulator ────────────────────────────────
# Only available when NODE_ENV=development
DEV_SIMULATOR_ENABLED=true

# ─── FCM (Firebase Cloud Messaging) ───────────────
# Leave empty until FCM is configured
# FCM_SERVER_KEY=
# FIREBASE_PROJECT_ID=

# ─── AI Service ───────────────────────────────────
# URL of the Python FastAPI prediction service
# AI_SERVICE_URL=http://localhost:8000
